<?xml version="1.0"?>
<robot name="patrol_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===== Design targets (see project guide, section 7) ===== -->
  <xacro:property name="body_length" value="0.35"/>
  <xacro:property name="body_width" value="0.28"/>
  <xacro:property name="body_height" value="0.12"/>
  <xacro:property name="body_mass" value="3.0"/>
  <xacro:property name="ground_clearance" value="0.03"/>

  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_width" value="0.03"/>
  <xacro:property name="wheel_separation" value="0.24"/>
  <xacro:property name="wheel_mass" value="0.3"/>

  <xacro:property name="caster_radius" value="0.03"/>
  <xacro:property name="caster_mass" value="0.1"/>
  <xacro:property name="caster_x" value="0.12"/>

  <!-- body centre height relative to base_link (base_link sits at the wheel axle) -->
  <xacro:property name="body_z" value="${ground_clearance + body_height/2 - wheel_radius}"/>
  <xacro:property name="body_top_z" value="${body_z + body_height/2}"/>

  <xacro:property name="max_linear_speed" value="0.3"/>
  <xacro:property name="max_angular_speed" value="1.5"/>

  <!-- ===== Materials ===== -->
  <material name="body_blue"><color rgba="0.1 0.3 0.7 1.0"/></material>
  <material name="dark"><color rgba="0.08 0.08 0.08 1.0"/></material>
  <material name="red"><color rgba="0.8 0.1 0.1 1.0"/></material>

  <!-- ===== Inertia macros ===== -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertia ixx="${m*(y*y+z*z)/12.0}" ixy="0" ixz="0"
             iyy="${m*(x*x+z*z)/12.0}" iyz="0"
             izz="${m*(x*x+y*y)/12.0}"/>
  </xacro:macro>
  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertia ixx="${m*(3*r*r+h*h)/12.0}" ixy="0" ixz="0"
             iyy="${m*(3*r*r+h*h)/12.0}" iyz="0"
             izz="${m*r*r/2.0}"/>
  </xacro:macro>
  <xacro:macro name="sphere_inertia" params="m r">
    <inertia ixx="${2.0*m*r*r/5.0}" ixy="0" ixz="0"
             iyy="${2.0*m*r*r/5.0}" iyz="0"
             izz="${2.0*m*r*r/5.0}"/>
  </xacro:macro>

  <!-- ===== Links and joints ===== -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${body_z}"/>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
      <material name="body_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${body_z}"/>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${body_z}"/>
      <mass value="${body_mass}"/>
      <xacro:box_inertia m="${body_mass}" x="${body_length}" y="${body_width}" z="${body_height}"/>
    </inertial>
  </link>

  <!-- Drive wheels. Both use the same joint axis: positive rotation = forward. -->
  <xacro:macro name="wheel" params="name y">
    <link name="${name}_wheel">
      <visual>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="dark"/>
      </visual>
      <collision>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
      </inertial>
    </link>
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_wheel"/>
      <origin xyz="0 ${y} 0" rpy="${-pi/2} 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
    <gazebo reference="${name}_wheel">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:wheel name="left"  y="${wheel_separation/2}"/>
  <xacro:wheel name="right" y="${-wheel_separation/2}"/>

  <!-- Passive frictionless casters -->
  <xacro:macro name="caster" params="name x">
    <link name="${name}_caster">
      <visual>
        <geometry><sphere radius="${caster_radius}"/></geometry>
        <material name="dark"/>
      </visual>
      <collision>
        <geometry><sphere radius="${caster_radius}"/></geometry>
      </collision>
      <inertial>
        <mass value="${caster_mass}"/>
        <xacro:sphere_inertia m="${caster_mass}" r="${caster_radius}"/>
      </inertial>
    </link>
    <joint name="${name}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_caster"/>
      <origin xyz="${x} 0 ${caster_radius - wheel_radius}"/>
    </joint>
    <gazebo reference="${name}_caster">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:caster name="front" x="${caster_x}"/>
  <xacro:caster name="rear"  x="${-caster_x}"/>

  <!-- LiDAR on top, slightly behind the centre -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.04" length="0.04"/></geometry>
      <material name="red"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.04" length="0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <xacro:cylinder_inertia m="0.1" r="0.04" h="0.04"/>
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="-0.05 0 ${body_top_z + 0.02}"/>
  </joint>

  <!-- Camera on the front face (x forward, y left, z up) -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.03 0.06 0.03"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <geometry><box size="0.03 0.06 0.03"/></geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <xacro:box_inertia m="0.05" x="0.03" y="0.06" z="0.03"/>
    </inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${body_length/2 + 0.015} 0 ${body_top_z + 0.30}"/>
  </joint>

  <!-- ===== Gazebo plugins ===== -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <max_linear_velocity>${max_linear_speed}</max_linear_velocity>
      <min_linear_velocity>${-max_linear_speed}</min_linear_velocity>
      <max_angular_velocity>${max_angular_speed}</max_angular_velocity>
      <min_angular_velocity>${-max_angular_speed}</min_angular_velocity>
      <odom_publish_frequency>30</odom_publish_frequency>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
  </gazebo>

  <!-- 2D LiDAR: 360 samples, 10 Hz, 0.12 to 8 m -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <topic>scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>8.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- RGB camera 640x480 (15 Hz to spare VM CPU) -->
  <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <topic>camera/image_raw</topic>
      <gz_frame_id>camera_link</gz_frame_id>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>15.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

</robot>
