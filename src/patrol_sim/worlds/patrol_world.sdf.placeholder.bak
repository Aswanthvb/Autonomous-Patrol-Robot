<?xml version="1.0"?>
<sdf version="1.9">
  <world name="patrol_world">

    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_north">
      <static>true</static>
      <pose>0 4.1 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10.4 0.2 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>10.4 0.2 2.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -4.1 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10.4 0.2 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>10.4 0.2 2.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>5.1 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 8 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 8 2.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-5.1 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 8 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 8 2.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="divider_north">
      <static>true</static>
      <pose>0 2.5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 3.0 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 3.0 2.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="divider_south">
      <static>true</static>
      <pose>0 -2.5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 3.0 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 3.0 2.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="obstacle_box_1">
      <static>true</static>
      <pose>-3.0 1.5 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.6 0.6 0.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.6 0.6</size></box></geometry>
          <material><ambient>0.55 0.35 0.15 1</ambient><diffuse>0.55 0.35 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="obstacle_box_2">
      <static>true</static>
      <pose>3.0 -1.0 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.8 0.5 0.7</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.8 0.5 0.7</size></box></geometry>
          <material><ambient>0.55 0.35 0.15 1</ambient><diffuse>0.55 0.35 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="obstacle_box_3">
      <static>true</static>
      <pose>2.0 1.8 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><ambient>0.55 0.35 0.15 1</ambient><diffuse>0.55 0.35 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="target_person_1">
      <static>true</static>
      <pose>-3.5 -2.5 0 0 0 0</pose>
      <link name="link">
        <collision name="torso_c"><pose>0 0 0.6 0 0 0</pose><geometry><cylinder><radius>0.2</radius><length>1.2</length></cylinder></geometry></collision>
        <visual name="torso_v"><pose>0 0 0.6 0 0 0</pose><geometry><cylinder><radius>0.2</radius><length>1.2</length></cylinder></geometry>
          <material><ambient>0.1 0.4 0.8 1</ambient><diffuse>0.1 0.4 0.8 1</diffuse></material></visual>
        <visual name="head_v"><pose>0 0 1.32 0 0 0</pose><geometry><sphere><radius>0.12</radius></sphere></geometry>
          <material><ambient>0.9 0.7 0.55 1</ambient><diffuse>0.9 0.7 0.55 1</diffuse></material></visual>
      </link>
    </model>
    <model name="target_backpack_1">
      <static>true</static>
      <pose>3.5 2.5 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.3 0.2 0.4</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.2 0.4</size></box></geometry>
          <material><ambient>0.85 0.15 0.1 1</ambient><diffuse>0.85 0.15 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
